# Pflicht: Koordinaten des eigenen Messorts eintragen.
ORTSNETZ_LATITUDE=
ORTSNETZ_LONGITUDE=
ORTSNETZ_INTERFACE_IP=0.0.0.0
# Bei mehreren Zählern die Seriennummer aus --dry-run eintragen.
# ORTSNETZ_METER_SERIAL=
# Optional: installierte PV-Leistung in kWp.
# ORTSNETZ_PLANT_CAPACITY_KWP=9.8
# Optional: Netzfrequenz von einem anderen Gerät, falls der Zähler keine liefert.
# ORTSNETZ_FREQUENCY_URL=http://192.168.178.50/api/v2/status
# ORTSNETZ_FREQUENCY_KEY=Fac
# Optional: heutige PV-Tagesprognose aus Home Assistant (braucht PLANT_CAPACITY_KWP).
# ORTSNETZ_PV_FORECAST_HA_URL=http://192.168.178.20:8123
# ORTSNETZ_PV_FORECAST_HA_TOKEN=
# ORTSNETZ_PV_FORECAST_HA_ENTITY=sensor.solcast_pv_forecast_prognose_heute
